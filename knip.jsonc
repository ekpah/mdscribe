{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	"ignoreIssues": {
		"packages/design-system/styles/globals.css": ["unresolved"],
	},
	"workspaces": {
		"apps/app": {
			"entry": [
				// Keep Next.js auto-detected entrypoints from plugins.
				// These entries only cover Bun test discovery that Knip cannot infer.
				"__tests__/setup.ts",
				"__tests__/{lib,orpc}/**/*.test.ts",
			],
		},
		"packages/database": {
			// Static analysis does not need to execute the environment-gated
			// Drizzle CLI config; package entrypoints already reach the schema.
			"drizzle": false,
			"ignoreFiles": ["drizzle.config.ts"],
		},
		"packages/markdoc-md": {
			"entry": [
				// Published package entry points are intentionally broader than the
				// subset currently consumed by this monorepo.
				"{index,citations,config,editor,parse,react,sources}.ts",
				"**/*.test.{ts,tsx}",
				// The build script invokes these consumer-facing package checks.
				"__tests__/public-types.tsx",
				"__tests__/verify-dist.mjs",
			],
		},
		"packages/markdoc-md-editor": {
			"entry": ["tip-tap.tsx", "tag-inspector/{tag-inspector,tag-inspector-sheet}.tsx"],
		},
	},
}
