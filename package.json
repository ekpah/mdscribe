{
	"name": "mdscribe",
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/ekpah/mdscribe.git"
	},
	"homepage": "https://mdscribe.de",
	"files": [
		"index.js"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:affected": "turbo run lint --affected",
		"lint:strict": "oxlint . --config .oxlintrc.strict.json || true",
		"lint:strict:summary": "oxlint . --config .oxlintrc.strict.json --format json > /tmp/oxlint-strict.json || true && echo \"diagnostics:\" && jq '.diagnostics | length' /tmp/oxlint-strict.json && echo \"top rules:\" && jq -r '.diagnostics[].code' /tmp/oxlint-strict.json | sort | uniq -c | sort -nr | head -n 25",
		"test": "turbo run test",
		"test:affected": "turbo run test --affected",
		"typecheck": "turbo run typecheck",
		"analyze": "turbo run analyze",
		"db:up": "docker compose -f docker-compose.dev-db.yml up -d && docker compose -f docker-compose.dev-db.yml wait postgres && bun run db:init",
		"db:down": "docker compose -f docker-compose.dev-db.yml down",
		"db:reset": "docker compose -f docker-compose.dev-db.yml down -v",
		"db:logs": "docker compose -f docker-compose.dev-db.yml logs -f postgres",
		"db:init": "cd packages/database && bun run bootstrap",
		"bump-deps": "npx npm-check-updates --deep -u -x react-day-picker && bun install",
		"db:bootstrap": "bun --cwd packages/database run bootstrap",
		"migrate": "bun --cwd packages/database run migrate",
		"knip": "knip"
	},
	"catalog": {
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"typescript": "^5.9.3",
		"@types/bun": "^1.3.5",
		"@types/node": "^24.9.2",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"postcss": "^8.5.6",
		"lucide-react": "^0.554.0",
		"sonner": "^2.0.3",
		"zod": "^3.25.67",
		"@radix-ui/react-icons": "^1.3.2",
		"next": "^16.0.10"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^24.10.1",
		"knip": "^5.70.0",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"turbo": "^2.7.1",
		"typescript": "^5.9.3",
		"ultracite": "^7.0.0"
	},
	"engines": {
		"node": ">=18"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"packageManager": "bun@1.2.23"
}
