{
	"name": "mdscribe",
	"version": "0.1.0",
	"homepage": "https://mdscribe.de",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/ekpah/mdscribe.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"files": [
		"index.js"
	],
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format:check": "oxfmt --check .",
		"lint": "turbo run lint",
		"lint:affected": "turbo run lint --affected",
		"test": "turbo run test",
		"test:affected": "turbo run test --affected",
		"typecheck": "turbo run typecheck",
		"db:up": "docker compose -f docker-compose.dev-db.yml up -d && docker compose -f docker-compose.dev-db.yml wait postgres && bun run db:init",
		"db:down": "docker compose -f docker-compose.dev-db.yml down",
		"db:reset": "docker compose -f docker-compose.dev-db.yml down -v",
		"db:logs": "docker compose -f docker-compose.dev-db.yml logs -f postgres",
		"db:init": "NODE_ENV=development MDSCRIBE_ALLOW_DEV_SEED=1 bun run db:bootstrap",
		"db:bootstrap": "bun run --cwd packages/database bootstrap && bun run --cwd apps/app db:seed",
		"db:migrate": "bun run --cwd packages/database migrate",
		"db:migrate:deploy": "bun run db:migrate",
		"migrate": "bun run db:migrate",
		"db:push": "bun run --cwd packages/database push",
		"knip": "knip --config knip.jsonc --cache",
		"knip:strict": "knip --config knip.jsonc --cache --strict",
		"knip:production": "knip --config knip.jsonc --cache --production --strict",
		"knip:ci": "bun run knip"
	},
	"devDependencies": {
		"@shadcn/lint": "^0.2.5",
		"@types/node": "catalog:",
		"knip": "^6.47.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"turbo": "2.11.13",
		"typescript": "catalog:",
		"ultracite": "^8.3.1"
	},
	"overrides": {
		"esbuild@~0.18.20": "0.28.2",
		"postcss-selector-parser": "7.2.1",
		"prosemirror-model": "1.25.13",
		"prosemirror-view": "1.43.0",
		"react": "19.3.1"
	},
	"engines": {
		"node": "^22.23.4 || ^24.22.3 || >=26.13.1"
	},
	"packageManager": "bun@1.4.5",
	"catalog": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"@types/bun": "^1.4.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"postcss": "^8.5.33",
		"lucide-react": "^1.77.0",
		"zod": "^4.6.7",
		"next": "^16.4.6",
		"recharts": "^3.11.0",
		"react-hook-form": "^7.92.0",
		"react-hotkeys-hook": "^5.4.0",
		"sonner": "^2.0.8",
		"@tanstack/react-table": "^9.3.1",
		"ai": "^7.0.178",
		"@ai-sdk/anthropic": "^4.0.107",
		"@ai-sdk/openai": "^4.0.122",
		"@ai-sdk/openai-compatible": "^3.0.94",
		"@ai-sdk/react": "^4.0.182",
		"@tailwindcss/postcss": "^4.3.5"
	}
}
