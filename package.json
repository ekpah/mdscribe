{
  "name": "mdscribe",
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://mdscribe.de",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekpah/mdscribe.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "files": [
    "index.js"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:affected": "turbo run lint --affected",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose -f docker-compose.dev-db.yml up -d && docker compose -f docker-compose.dev-db.yml wait postgres && bun run db:init",
    "db:down": "docker compose -f docker-compose.dev-db.yml down",
    "db:reset": "docker compose -f docker-compose.dev-db.yml down -v",
    "db:logs": "docker compose -f docker-compose.dev-db.yml logs -f postgres",
    "db:init": "NODE_ENV=development MDSCRIBE_ALLOW_DEV_SEED=1 bun run --cwd packages/database bootstrap",
    "db:bootstrap": "bun run --cwd packages/database bootstrap",
    "db:migrate": "bun run --cwd packages/database migrate",
    "db:migrate:deploy": "bun run db:migrate",
    "migrate": "bun run db:migrate",
    "db:push": "bun run --cwd packages/database push",
    "knip": "knip --config knip.jsonc --cache",
    "knip:strict": "knip --config knip.jsonc --cache --strict",
    "knip:production": "knip --config knip.jsonc --cache --production --strict",
    "knip:ci": "bun run knip"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "knip": "^6.31.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "turbo": "2.10.9",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.1"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "tar": "7.5.22"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "bun@1.2.23",
  "catalog": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.13",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.25",
    "lucide-react": "^0.576.0",
    "zod": "^4.3.6",
    "next": "^16.2.9",
    "recharts": "^3.8.1",
    "react-hook-form": "^7.73.1",
    "react-hotkeys-hook": "^5.2.4",
    "sonner": "^2.0.7",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.168",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@ai-sdk/react": "^3.0.170",
    "@tailwindcss/postcss": "^4.3.3"
  }
}
