{
	"name": "mdscribe",
	"version": "0.1.0",
	"homepage": "https://mdscribe.de",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/ekpah/mdscribe.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"files": [
		"index.js"
	],
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format:check": "oxfmt --check .",
		"lint": "turbo run lint",
		"lint:affected": "turbo run lint --affected",
		"test": "turbo run test",
		"test:affected": "turbo run test --affected",
		"typecheck": "turbo run typecheck",
		"db:up": "docker compose -f docker-compose.dev-db.yml up -d && docker compose -f docker-compose.dev-db.yml wait postgres && bun run db:init",
		"db:down": "docker compose -f docker-compose.dev-db.yml down",
		"db:reset": "docker compose -f docker-compose.dev-db.yml down -v",
		"db:logs": "docker compose -f docker-compose.dev-db.yml logs -f postgres",
		"db:init": "NODE_ENV=development MDSCRIBE_ALLOW_DEV_SEED=1 bun run db:bootstrap",
		"db:bootstrap": "bun run --cwd packages/database bootstrap && bun run --cwd apps/app db:seed",
		"db:migrate": "bun run --cwd packages/database migrate",
		"db:migrate:deploy": "bun run db:migrate",
		"migrate": "bun run db:migrate",
		"db:push": "bun run --cwd packages/database push",
		"knip": "knip --config knip.jsonc --cache",
		"knip:strict": "knip --config knip.jsonc --cache --strict",
		"knip:production": "knip --config knip.jsonc --cache --production --strict",
		"knip:ci": "bun run knip"
	},
	"devDependencies": {
		"@shadcn/lint": "^0.2.3",
		"@types/node": "catalog:",
		"knip": "^6.42.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"turbo": "2.11.10",
		"typescript": "catalog:",
		"ultracite": "^7.12.4"
	},
	"overrides": {
		"esbuild@~0.18.20": "0.25.12",
		"postcss-selector-parser": "7.1.7",
		"prosemirror-model": "1.25.12",
		"prosemirror-view": "1.42.7",
		"react": "19.3.1"
	},
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || >=26.12.1"
	},
	"packageManager": "bun@1.4.4",
	"catalog": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"@types/bun": "^1.4.4",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"postcss": "^8.5.31",
		"lucide-react": "^0.577.0",
		"zod": "^4.6.7",
		"next": "^16.4.3",
		"recharts": "^3.10.1",
		"react-hook-form": "^7.90.0",
		"react-hotkeys-hook": "^5.3.3",
		"sonner": "^2.0.8",
		"@tanstack/react-table": "^8.21.3",
		"ai": "^6.0.315",
		"@ai-sdk/anthropic": "^3.0.135",
		"@ai-sdk/openai": "^3.0.131",
		"@ai-sdk/openai-compatible": "^2.0.87",
		"@ai-sdk/react": "^3.0.318",
		"@tailwindcss/postcss": "^4.3.3"
	}
}
