{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    "oxlint.config.ts",
    ".oxfmtrc.jsonc"
  ],
  "globalPassThroughEnv": ["SKIP_ENV_VALIDATION"],
  "globalEnv": [
    "POSTGRES_DATABASE_URL",
    "AUTH_POSTMARK_KEY",
    "BETTER_AUTH_SECRET",
    "OPENROUTER_API_KEY",
    "BASE_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PLUS_PRICE_ID",
    "STRIPE_PLUS_PRICE_ID_ANNUAL",
    "ADMIN_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@repo/database#build": {
      "env": ["POSTGRES_DATABASE_URL"],
      "outputs": ["**/drizzle/generated/**"]
    },
    "@repo/database#dev": {
      "env": ["POSTGRES_DATABASE_URL"],
      "outputs": ["**/drizzle/generated/**"]
    },
    "app#build": {
      "dependsOn": ["@repo/database#build"]
    },
    "email#build": {
      "outputs": ["out/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
