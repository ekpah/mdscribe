{
	"name": "markdoc-md",
	"version": "0.1.0",
	"description": "Typed Markdoc schemas, validation, React rendering, dynamic inputs, FHIR sources, scores, and citations for medical documentation.",
	"keywords": [
		"citations",
		"fhir",
		"markdoc-md",
		"markdown",
		"react",
		"typescript"
	],
	"homepage": "https://github.com/ekpah/mdscribe/tree/main/packages/markdoc-md#readme",
	"bugs": {
		"url": "https://github.com/ekpah/mdscribe/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ekpah/mdscribe.git",
		"directory": "packages/markdoc-md"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": true,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./citations": {
			"types": "./dist/citations.d.ts",
			"import": "./dist/citations.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./editor": {
			"types": "./dist/editor.d.ts",
			"import": "./dist/editor.js"
		},
		"./parse": {
			"types": "./dist/parse.d.ts",
			"import": "./dist/parse.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./sources": {
			"types": "./dist/sources.d.ts",
			"import": "./dist/sources.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun scripts/build.mjs",
		"check": "bun run build && bun run test && bun run typecheck",
		"prepack": "bun run build",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@markdoc/markdoc": "^0.5.7",
		"fhirpath": "^5.1.0",
		"fparser": "^4.2.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"react": ">=18.2.0 <20.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	}
}
