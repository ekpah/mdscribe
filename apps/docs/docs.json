{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MDScribe",
  "description": "Dokumentation fuer MDScribe.",
  "colors": {
    "primary": "#268bd2",
    "light": "#2aa198",
    "dark": "#268bd2"
  },
  "background": {
    "color": {
      "light": "#fdf6e3",
      "dark": "#002b36"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "solarized-light",
        "dark": "solarized-dark"
      }
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "index",
          "quickstart/index",
          "quickstart/schnellstart",
          "faq"
        ]
      },
      {
        "group": "Tutorials",
        "pages": [
          "tutorials/index"
        ]
      },
      {
        "group": "How-to",
        "pages": [
          "how-to/index",
          "how-to/ki-instruktionen",
          "how-to/self-hosting"
        ]
      },
      {
        "group": "Produktbereiche",
        "pages": [
          "templates/index",
          "templates/tags",
          "templates/info-tag",
          "templates/score-tag",
          "templates/switch-case-tags",
          "documents/index",
          "ai/index",
          "ai/ki-instruktionen",
          "text-snippets",
          "knowledge"
        ]
      },
      {
        "group": "KI-Provider",
        "pages": [
          "providers/index",
          "providers/openrouter",
          "providers/openai-compatible",
          "providers/private",
          "providers/local",
          "providers/openai",
          "providers/anthropic"
        ]
      },
      {
        "group": "Datenschutz",
        "pages": [
          "privacy/index",
          "privacy/private-vs-anonyme-daten",
          "privacy/ki-datenfluss"
        ]
      },
      {
        "group": "Self-Hosting",
        "pages": [
          "self-hosting/index"
        ]
      },
      {
        "group": "Referenz",
        "pages": [
          "reference/index",
          "reference/tags"
        ]
      },
      {
        "group": "Erklaerungen",
        "pages": [
          "explanation/index",
          "explanation/diataxis",
          "explanation/privacy"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/content/docs/:slug*",
      "destination": "/:slug*"
    },
    {
      "source": "/docs/tags",
      "destination": "/templates/tags"
    },
    {
      "source": "/docs/schnellstart",
      "destination": "/quickstart/schnellstart"
    },
    {
      "source": "/docs/ki-instruktionen",
      "destination": "/ai/ki-instruktionen"
    },
    {
      "source": "/docs/templates/:slug*",
      "destination": "/templates/:slug*"
    },
    {
      "source": "/docs/:slug*",
      "destination": "/:slug*"
    }
  ]
}
