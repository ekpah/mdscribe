{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"declaration": false,
		"declarationMap": false,
		"jsx": "preserve",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"paths": {
			"@/*": ["./*"],
			"@repo/*": ["../../packages/*"]
		},
		"plugins": [{ "name": "next" }],
		"types": ["bun", "node"]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"markdoc/variables.ts",
		"next.config.ts"
	],
	"exclude": ["node_modules"]
}
