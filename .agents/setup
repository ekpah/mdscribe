#!/usr/bin/env bash
# Amp Orb bootstrap only. Assumes a disposable Debian environment.
# Do not run on persistent or production PostgreSQL hosts.

set -euo pipefail

SECONDS=0
step() {
	printf '\n[setup +%ss] %s\n' "${SECONDS}" "$*"
}
trap 'status=$?; printf "\n[setup +%ss] Finished (exit %s).\n" "${SECONDS}" "${status}"' EXIT

readonly BUN_VERSION="1.4.4"
readonly NODE_VERSION="24.22.1"
readonly PGVECTOR_VERSION="0.8.1"
readonly DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/mdscribe"
readonly TEST_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/mdscribe_test"

step "Checking system dependencies..."
readonly -a SYSTEM_PACKAGES=(
	build-essential
	ca-certificates
	curl
	# Roboto is in the app's system font stack; without it, headless Chromium
	# takes spaces and digits from Noto Color Emoji and screenshots look broken.
	fonts-roboto
	postgresql
	postgresql-contrib
	# Match Debian's default server: PostgreSQL 15 on bookworm, 17 on trixie.
	postgresql-server-dev-all
	ssl-cert
	xz-utils
)
missing_packages=()
for package in "${SYSTEM_PACKAGES[@]}"; do
	if [[ "$(dpkg-query -W -f='${Status}' "${package}" 2>/dev/null || true)" != "install ok installed" ]]; then
		missing_packages+=("${package}")
	fi
done
if (( ${#missing_packages[@]} )); then
	sudo apt-get update
	sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi

if [[ ! -f /etc/ssl/certs/ssl-cert-snakeoil.pem ]]; then
	sudo DEBIAN_FRONTEND=noninteractive \
		/usr/sbin/make-ssl-cert generate-default-snakeoil --force-overwrite
fi

step "Checking pgvector ${PGVECTOR_VERSION}..."
if [[ ! -f "$(pg_config --sharedir)/extension/vector.control" ]]; then
	(
		pgvector_source="$(mktemp -d)"
		trap 'rm -rf -- "${pgvector_source}"' EXIT
		curl -fsSL "https://github.com/pgvector/pgvector/archive/refs/tags/v${PGVECTOR_VERSION}.tar.gz" \
			| tar -xz --strip-components=1 -C "${pgvector_source}"
		make -j"$(nproc)" -C "${pgvector_source}"
		sudo make -C "${pgvector_source}" install
	)
fi

step "Checking Node.js ${NODE_VERSION}..."
if ! command -v node >/dev/null 2>&1 || [[ "$(node --version)" != "v${NODE_VERSION}" ]]; then
	curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
		| sudo tar -xJ --strip-components=1 -C /usr/local
fi

step "Checking Bun ${BUN_VERSION}..."
export BUN_INSTALL="${HOME}/.bun"
export PATH="${BUN_INSTALL}/bin:${PATH}"
if ! command -v bun >/dev/null 2>&1 || [[ "$(bun --version)" != "${BUN_VERSION}" ]]; then
	curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}"
	# Only link our own install; the base image may already provide Bun elsewhere.
	sudo ln -sf "${BUN_INSTALL}/bin/bun" /usr/local/bin/bun
fi

step "Installing workspace dependencies..."
bun install --frozen-lockfile

step "Removing retired OCR test caches from older snapshots..."
rm -rf -- "${HOME}/.cache/mdscribe/paddleocr-venv" \
	"${HOME}/.cache/mdscribe/paddleocr-models" \
	"${HOME}/.cache/mdscribe/paddleocr-warm.log"

ensure_env_defaults() {
	local env_file="$1"
	local key value
	shift

	touch "${env_file}"
	for entry in "$@"; do
		key="${entry%%=*}"
		value="${entry#*=}"
		if ! grep -q "^${key}=" "${env_file}"; then
			printf '%s="%s"\n' "${key}" "${value}" >>"${env_file}"
		fi
	done
}

readonly -a ENV_DEFAULTS=(
	"MAIL_SMTP_URL=smtp://127.0.0.1:1025?ignoreTLS=true"
	"MAIL_BROADCAST_SMTP_URL="
	"MAIL_FROM_ADDRESS=noreply@example.com"
	"MAIL_FROM_NAME=MDScribe"
	"NEXT_PUBLIC_BASE_URL=http://localhost:3000"
	"BETTER_AUTH_SECRET=orb-development-secret-not-for-production"
	"BETTER_AUTH_URL=http://localhost:3000"
	"ADMIN_EMAIL=test@test.com"
	"POSTGRES_DATABASE_URL=${DATABASE_URL}"
	"POSTGRES_DATABASE_URL_TEST=${TEST_DATABASE_URL}"
	"OPENROUTER_API_KEY=orb-placeholder"
	"STRIPE_SECRET_KEY=orb-placeholder"
	"STRIPE_WEBHOOK_SECRET=orb-placeholder"
	"STRIPE_PLUS_PRICE_ID=orb-placeholder"
	"STRIPE_PLUS_PRICE_ID_ANNUAL=orb-placeholder"
)

step "Ensuring local development environment..."
ensure_env_defaults .env "${ENV_DEFAULTS[@]}"

if [[ ! -e apps/app/.env && ! -L apps/app/.env ]]; then
	cp -- .env apps/app/.env
fi
ensure_env_defaults apps/app/.env "${ENV_DEFAULTS[@]}"

step "Starting PostgreSQL..."
while read -r version cluster _ status _; do
	if [[ "${status}" != "online" ]]; then
		sudo pg_ctlcluster --skip-systemctl-redirect "${version}" "${cluster}" start
	fi
done < <(pg_lsclusters --no-header)

step "Preparing local databases..."
sudo -u postgres psql --quiet --set ON_ERROR_STOP=1 <<'SQL'
ALTER USER postgres PASSWORD 'postgres';
ALTER SYSTEM SET fsync = 'off';
ALTER SYSTEM SET synchronous_commit = 'off';
SQL

for database in mdscribe mdscribe_test; do
	if ! sudo -u postgres psql --tuples-only --no-align --command \
		"SELECT 1 FROM pg_database WHERE datname = '${database}'" | grep -q 1; then
		sudo -u postgres createdb "${database}"
	fi
done

step "Applying database migrations and development seed data..."
NODE_ENV="development" MDSCRIBE_ALLOW_DEV_SEED="1" MDSCRIBE_SKIP_AI_SEED="1" POSTGRES_DATABASE_URL="${DATABASE_URL}" \
	bun run db:bootstrap

step "Orb setup complete."
