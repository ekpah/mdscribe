# Mail provider (generic SMTP or an on-premises SMTP relay)
MAIL_SMTP_URL="smtp://username:password@smtp.example.com:587?requireTLS=true"
# Optional: use a separate provider/stream for marketing broadcasts.
# Leave empty to reuse MAIL_SMTP_URL.
MAIL_BROADCAST_SMTP_URL=""
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="MDScribe"

# Auth Env Variables
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app
# Admin email - the instance admin who manages the deployment
ADMIN_EMAIL=""
# Database connection
POSTGRES_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/mdscribe"
# LLM API KEYS
# Optional: first-run development seed creates providers from these keys.
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
MISTRAL_API_KEY=""
TINFOIL_API_KEY=""
# Stripe connection
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price ids
STRIPE_PLUS_PRICE_ID=""
STRIPE_PLUS_PRICE_ID_ANNUAL=""
# Langfuse llm logging
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASEURL="https://cloud.langfuse.com"
